# Database
DATABASE_URL="postgresql://username:password@localhost:5432/levitate_studios_ai_agent"

# Redis
REDIS_URL="redis://localhost:6379"

# Server
PORT=3000
NODE_ENV="development"
JWT_SECRET="your-super-secure-jwt-secret-key-change-this-in-production"

# Google APIs
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/auth/google/callback"
GOOGLE_PRIVATE_KEY="your-google-service-account-private-key"
GOOGLE_CLIENT_EMAIL="your-service-account@your-project.iam.gserviceaccount.com"
GOOGLE_PROJECT_ID="your-google-project-id"
GOOGLE_APPS_SCRIPT_SECRET="your-apps-script-webhook-secret-key"

# Brevo (formerly SendinBlue)
BREVO_API_KEY="your-brevo-api-key"
BREVO_WEBHOOK_SECRET="your-brevo-webhook-secret"

# Asana
ASANA_ACCESS_TOKEN="your-asana-access-token"
ASANA_WORKSPACE_GID="your-asana-workspace-gid"

# OpenAI / LLM
OPENAI_API_KEY="your-openai-api-key"
ANTHROPIC_API_KEY="your-anthropic-api-key"

# Application Settings
ADMIN_EMAIL="admin@levitate.ng"
FRONTEND_URL="http://localhost:3001"
EMAIL_DOMAIN="levitate.ng"

# Logging
LOG_LEVEL="info"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100